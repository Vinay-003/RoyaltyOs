{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist/apps/web/public",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://royaltyos-api-o45c.onrender.com/api/:path*"
    },
    {
      "source": "/",
      "destination": "/landing.html"
    },
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/:path*",
      "destination": "/app.html"
    },
    {
      "source": "/:route(insights|contracts|rule-graph|simulator|invoices|settlements|payouts|royalties|recipients|team|notifications|paypal-ai|audit|profile)",
      "destination": "/app.html"
    },
    {
      "source": "/(.*)",
      "destination": "/landing.html"
    }
  ]
}
