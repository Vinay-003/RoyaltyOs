# RoyaltyOS v1.0.2
NODE_ENV=development
PORT=3000
APP_BASE_URL=http://localhost:3000
APP_VERSION=1.0.2
LOG_LEVEL=info

# Supabase - backend only unless marked public
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY
SUPABASE_STORAGE_BUCKET=royaltyos-contracts
# Direct Postgres URL. Powers boot-time migrations (server and worker apply
# pending supabase/migrations files automatically when set) plus Supabase
# CLI/psql use. Required on Render so deploys migrate themselves.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT.supabase.co:5432/postgres

# PayPal Sandbox (switch PAYPAL_ENVIRONMENT=live only after go-live review)
PAYPAL_ENVIRONMENT=sandbox
PAYPAL_CLIENT_ID=YOUR_PAYPAL_SANDBOX_CLIENT_ID
PAYPAL_CLIENT_SECRET=YOUR_PAYPAL_SANDBOX_CLIENT_SECRET
PAYPAL_WEBHOOK_ID=YOUR_PAYPAL_SANDBOX_WEBHOOK_ID
PAYPAL_DEFAULT_CURRENCY=USD
PAYPAL_PAYOUT_EMAIL_SUBJECT="RoyaltyOS royalty payout"
PAYPAL_PAYOUT_NOTE="RoyaltyOS settlement payout"

# AI contract intelligence - OpenAI Responses API (or an OpenAI-compatible gateway)
AI_PROVIDER=openai
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-6-astra
# Attach the native PDF alongside extracted text. Only enable for providers
# proven to forward input_file to the model (api.openai.com). Most compatible
# gateways bill the file tokens and silently drop the part: the model then
# reports no document attached while tokens burn.
OPENAI_SEND_PDF_FILE=false
# Contract extraction input: text (server-extracted PDF text, strict schema,
# works on every gateway) or vision (rendered page images through
# chat/completions with tolerant parsing plus one repair retry).
# Measured on apinex.bond: vision works with free/gpt-6-luna and
# free/mimo-v2.6-pro; free/deepseek-v4.1-flash hangs on image input, so it
# must stay on text mode. /responses drops file/image parts on this gateway.
AI_EXTRACTION_MODE=text
AI_VISION_MAX_PAGES=10
OPENAI_PDF_DETAIL=low
AI_MAX_PDF_BYTES=10485760
AI_MAX_PDF_PAGES=100

# PayPal AI integration - official PayPal remote MCP through OpenAI Responses API
PAYPAL_AI_ENABLED=true
PAYPAL_MCP_SERVER_URL=https://mcp.sandbox.paypal.com/http
PAYPAL_MCP_MODEL=gpt-6-astra
# Deliberately read-only tools. Adjust only after reviewing PayPal's current tool catalog.
PAYPAL_MCP_ALLOWED_TOOLS=list_invoices,get_invoice,list_transactions

# Security
STEP_UP_TTL_SECONDS=900
MAX_UPLOAD_BYTES=10485760
MAX_PDF_PAGES=100
MALWARE_SCAN_MODE=disabled
# Set MALWARE_SCAN_MODE=clamav in production and configure:
CLAMAV_HOST=127.0.0.1
CLAMAV_PORT=3310
CORS_ORIGINS=http://localhost:3000

# Worker
WORKER_POLL_INTERVAL_MS=3000
WORKER_BATCH_SIZE=20
WORKER_MAX_ATTEMPTS=8

# External API resilience
PAYPAL_TIMEOUT_MS=15000
PAYPAL_MAX_RETRIES=3
PAYPAL_RETRY_BASE_MS=250
AI_TIMEOUT_MS=120000
AI_MAX_RETRIES=2
AI_RETRY_BASE_MS=500

# Optional email notifications (Should-Have in architecture record)
NOTIFICATION_PROVIDER=disabled
RESEND_API_KEY=
NOTIFICATION_FROM_EMAIL="RoyaltyOS <notifications@example.com>"

# External E2E test helpers (never use production accounts in test scripts)
TEST_APP_URL=http://localhost:3000
TEST_USER_EMAIL=
TEST_USER_PASSWORD=
TEST_PAYPAL_BUYER_EMAIL=
TEST_PAYPAL_PAYOUT_EMAIL_1=
TEST_PAYPAL_PAYOUT_EMAIL_2=
